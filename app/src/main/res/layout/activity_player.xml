<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.vidora.player.VidoraPlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#99000000">

        <Button
            android:id="@+id/backButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:contentDescription="بازگشت" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/fullscreenButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="⛶"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:contentDescription="تمام صفحه" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/controlScroll"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:background="#DD111111"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/controlBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <Button
                android:id="@+id/previousButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="52dp"
                android:text="⏮"
                android:textAllCaps="false"
                android:contentDescription="ویدئوی قبلی" />

            <Button
                android:id="@+id/pauseButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:text="⏸ توقف"
                android:textAllCaps="false"
                android:contentDescription="توقف یا پخش" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="52dp"
                android:text="⏭"
                android:textAllCaps="false"
                android:contentDescription="ویدئوی بعدی" />

            <Button
                android:id="@+id/repeatButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:text="تکرار"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/audioButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:text="صدا"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/favoriteButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:text="♡"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/speedMinusButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="52dp"
                android:text="−"
                android:textSize="20sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/speedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="64dp"
                android:text="1.0×"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/speedPlusButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="52dp"
                android:text="+"
                android:textSize="20sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/aspectButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="70dp"
                android:text="FIT"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/subtitleButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:text="زیرنویس"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/sleepTimerButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="80dp"
                android:text="@string/sleep_timer"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/shareButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="70dp"
                android:text="اشتراک"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="70dp"
                android:text="حذف"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/lockButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="70dp"
                android:text="@string/lock"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/moreButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="70dp"
                android:text="بیشتر"
                android:textAllCaps="false" />

        </LinearLayout>

    </HorizontalScrollView>

    <TextView
        android:id="@+id/gestureInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC111111"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lockedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="#66000000"
        android:text="🔒"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
