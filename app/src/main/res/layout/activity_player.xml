<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="#99000000">

        <Button
            android:id="@+id/speedMinusButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:text="−"
            android:textSize="18sp" />

        <Button
            android:id="@+id/speedButton"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:text="@string/speed_default"
            android:textSize="12sp" />

        <Button
            android:id="@+id/speedPlusButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:text="+"
            android:textSize="18sp" />

        <Button
            android:id="@+id/aspectButton"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:text="FIT"
            android:textSize="11sp" />

        <Button
            android:id="@+id/subtitleButton"
            android:layout_width="70dp"
            android:layout_height="44dp"
            android:text="@string/subtitle"
            android:textSize="11sp" />

        <Button
            android:id="@+id/sleepTimerButton"
            android:layout_width="70dp"
            android:layout_height="44dp"
            android:text="@string/sleep_timer"
            android:textSize="11sp" />

        <Button
            android:id="@+id/lockButton"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:text="@string/lock"
            android:textSize="11sp" />

        <Button
            android:id="@+id/fullscreenButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:text="@string/fullscreen"
            android:textSize="16sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/gestureInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:background="#99000000"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lockedOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:text="@string/screen_locked"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:background="#99000000"
        android:visibility="gone" />

</FrameLayout>
