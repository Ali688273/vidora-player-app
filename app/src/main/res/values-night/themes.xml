<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style
        name="Theme.Vidora"
        parent="android:style/Theme.Material.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="android:windowActionModeOverlay">
            true
        </item>

        <item name="android:windowLightStatusBar">
            false
        </item>

        <item name="android:statusBarColor">
            @color/vidora_background
        </item>

        <item name="android:navigationBarColor">
            @color/vidora_background
        </item>

        <item name="android:windowBackground">
            @color/vidora_background
        </item>

        <item name="android:colorAccent">
            @color/vidora_primary
        </item>

        <item name="android:textColorPrimary">
            @color/vidora_text
        </item>

        <item name="android:colorControlNormal">
            @color/vidora_text_secondary
        </item>

    </style>

</resources>
